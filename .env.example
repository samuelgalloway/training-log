# Google service account used for both Sheets and Drive access.
# Create a service account in Google Cloud Console, enable the Sheets API and
# Drive API, create a JSON key, then set these two from that key file.
# Share the target Sheet AND the target Drive folder with the service
# account's email (Editor access) — it has no access otherwise.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file. Keep the \n escapes literal
# (this app converts them to real newlines at startup).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from the Google Sheet's URL
# (https://docs.google.com/spreadsheets/d/<THIS_PART>/edit). It must already
# have three tabs named exactly: sets, sessions, body — each with a header
# row matching the columns in SPEC.md's Data model section.
GOOGLE_SHEETS_ID=

# The Drive folder ID from the folder's URL
# (https://drive.google.com/drive/folders/<THIS_PART>). Used to store
# config.json (equipment/plate inventory) and blocks/<block_id>.json (one
# file per training block, active + archived).
GOOGLE_DRIVE_FOLDER_ID=
